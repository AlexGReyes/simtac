{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "simtacv3",
  "version": "0.1.0",
  "identifier": "com.agrey.simtacv3",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": {
      "script": "npm run build:version",
      "wait": true
    },
    "beforeBuildCommand": "npm run build:version"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "simtacv3",
        "width": 800,
        "height": 600,
        "maximized": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY3NTY4MDFCRUQzNzc4RkMKUldUOGVEZnRHNEJXWjRLRkxQQTFYTWpRdFNwZHV3OEtpZ0tFZFhxVnFSKytEV251M1h5blN2VTEK",
      "windows": {
        "installMode": "passive"
      },
      "dangerousInsecureTransportProtocol": true
    }
  }
}
